{
  "name": "stuller-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Stuller jewelry-supply v2 API: product search, real-time pricing & availability, product detail/media, and gated ordering. Credentials are supplied via environment variables.",
  "type": "module",
  "main": "index.js",
  "bin": {
    "stuller-mcp": "index.js"
  },
  "files": [
    "index.js",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node index.js",
    "smoke": "node scripts/smoke.js",
    "test": "node --test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "stuller",
    "jewelry",
    "jewellery",
    "claude",
    "ai",
    "llm",
    "findings",
    "gemstones",
    "diamonds",
    "catalog",
    "api"
  ],
  "author": "CritterCodes",
  "license": "MIT",
  "homepage": "https://github.com/CritterCodes/stuller-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CritterCodes/stuller-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/CritterCodes/stuller-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
