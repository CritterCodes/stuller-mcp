# Stuller API credentials.
#
# These are a Stuller "developer login" — a set of Stuller.com credentials that
# CANNOT be used to sign in to the stuller.com website; they only authorize API
# requests. Create one from your Stuller account (Account > API / Developer access)
# or ask your Stuller representative.
#
# Copy this file to `.env` (which is git-ignored) and fill in your own values.
# Never commit real credentials.

STULLER_USERNAME=your-developer-login-username
STULLER_PASSWORD=your-developer-login-password

# Optional — defaults shown. Only change the base URL if Stuller tells you to.
STULLER_API_URL=https://api.stuller.com
STULLER_USER_AGENT=stuller-mcp/0.1.0

# Optional safety switch: set to "true" to hard-disable the order-submission
# write tool regardless of the confirm flag. Leave unset/false to allow orders.
STULLER_DISABLE_ORDERING=false

# --- Optional tuning (sensible defaults shown) ---
# Per-request timeout in milliseconds.
STULLER_TIMEOUT_MS=30000
# Retries on transient failures (429/502/503/504, network errors, timeouts).
STULLER_MAX_RETRIES=2
# Base backoff between retries (multiplied by attempt number).
STULLER_RETRY_DELAY_MS=400
# TTL for cached slow-changing reads (facet vocabulary, metal market rates).
# Set to 0 to disable caching. Pricing/inventory are never cached.
STULLER_CACHE_TTL_MS=600000

# Where favorites are stored. Defaults to ~/.stuller-mcp/favorites.json.
# STULLER_FAVORITES_PATH=/path/to/favorites.json
